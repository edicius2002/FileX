# C51: build documental CPU, linux/amd64, fuentes e identidad congeladas.
# Orden canónica (incluye epoch EXPLÍCITO y exportador comprobado):
#   python docker/construir_c13.py --tag filex-c13-repro
# Comprobar identidad y tres motores:
#   python docker/verificar_c13.py filex-c13-repro
# Usar en FileX: FILEX_IMAGEN_DOC=filex-c13-repro
#
# El índice multiarch histórico era b515b04bfd25; se fija su manifiesto amd64.
# El digest de base por sí solo no bastó: apt móvil cambiaba qpdf y caducaba
# 40 sellos (bench/contenedor-publicable.md). El snapshot conserva también las
# dependencias. No se heredan los sellos de la imagen histórica.
#
# Dos condiciones adicionales MEDIDAS: borrar aux-cache de ldconfig (contiene
# datos dependientes del build), y pasar SOURCE_DATE_EPOCH al builder; el ARG
# por defecto NO fija el exportador. rewrite-timestamp requiere unpack=false
# en el Docker con almacén containerd medido. c13.lock.json registra el digest.
# Check-Valid-Until=no permite índices históricos, manteniendo firmas y hashes.
FROM ghcr.io/c4illin/convertx@sha256:081d1638e8c6dfb6b5e69f47ff90e6f6037cdee29a2f25ddd44ddc6d2e52451d
ARG SOURCE_DATE_EPOCH=1788480000
USER root
COPY debian-c13.sources /tmp/debian-c13.sources
RUN rm -f /etc/apt/sources.list /etc/apt/sources.list.d/* \
 && cp /tmp/debian-c13.sources /etc/apt/sources.list.d/debian.sources \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      qpdf tesseract-ocr tesseract-ocr-spa tesseract-ocr-eng \
 && rm -rf /var/lib/apt/lists/* /var/log/apt/* /var/log/dpkg.log /tmp/debian-c13.sources \
 && rm -f /var/cache/ldconfig/aux-cache
