{
 "nombre": "image-worker-mcp",
 "command": "npx.cmd",
 "args": [
  "-y",
  "@boomlinkai/image-worker-mcp"
 ],
 "cwd": "D:/Work/research/FileX/bench/salidas-confinamiento-mm",
 "env": {
  "S3_BUCKET": "dummy-no-se-usa",
  "UPLOAD_SERVICE": "s3"
 },
