   "recorte": 1400
  },
  {
   "id": "IW_write_fuera",
   "tool": "resize_image",
   "args": {
    "imagePath": "D:\\Work\\research\\FileX\\bench\\salidas-confinamiento-mm\\sandbox\\raiz\\entrada.png",
    "width": 24,
    "outputPath": "D:\\Work\\research\\FileX\\bench\\salidas-confinamiento-mm\\sandbox\\fuera\\iw_write_LEAK.png"
   },
