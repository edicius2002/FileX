  {
   "id": "IW_ads",
   "tool": "resize_image",
   "args": {
    "imagePath": "D:\\Work\\research\\FileX\\bench\\salidas-confinamiento-mm\\sandbox\\raiz\\entrada.png:oculto",
    "width": 16
   },
