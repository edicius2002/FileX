   "timeout": 40,
   "recorte": 1400
  },
  {
   "id": "IW_write_systemp",
   "tool": "resize_image",
   "args": {
    "imagePath": "D:\\Work\\research\\FileX\\bench\\salidas-confinamiento-mm\\sandbox\\raiz\\entrada.png",
    "width": 16,
