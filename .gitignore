# Python: local environments, bytecode, and test/tool caches
.venv/
.venv-*/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# JavaScript package and build artifacts (if root tooling is added)
node_modules/
dist/
build/

# Local configuration and runtime state
.env
.env.*
!.env.example
.ccb/
.claude/settings.local.json

# Cloned third-party repositories used as research references
repos/

# Editor and operating-system artifacts
.DS_Store
Thumbs.db

# Benchmark outputs that are regenerable from bench/salidas-referencia/referencia.json
# (39 exact commands) or from the scripts in bench/scripts/. Each excluded directory
# keeps a MANIFIESTO.md with name, sha256, size, and the command that rebuilds it:
# the evidence stays verifiable without versioning the bytes.
bench/salidas-fase1/
bench/salidas-fase2/
bench/salidas-fidelidad/
bench/salidas-ocrmypdf/pdf/
bench/salidas-referencia/audio/
bench/salidas-referencia/datos/
bench/salidas-referencia/imagen/
bench/salidas-referencia/pdf/
bench/salidas-referencia/video/

# ...pero el manifiesto, los logs y los scripts de cada una SI se versionan:
# son el texto que hace verificable lo excluido.
!bench/salidas-referencia/referencia.json
!bench/salidas-fase1/
!bench/salidas-fase2/
!bench/salidas-fidelidad/
bench/salidas-fase1/*
bench/salidas-fase2/*
bench/salidas-fidelidad/*
!bench/salidas-fase1/MANIFIESTO.md
!bench/salidas-fase2/MANIFIESTO.md
!bench/salidas-fidelidad/MANIFIESTO.md
!bench/salidas-fase1/logs/
!bench/salidas-fase2/logs/
!bench/salidas-fidelidad/*.md
!bench/salidas-fidelidad/*.json
!bench/salidas-fidelidad/*.py
!bench/salidas-fidelidad/*.sh

# Intermediate rasterizations and scratch conversions produced while measuring.
**/tmp_corpus/
**/_scratch/

# Logs are text, cheap, and are the traceability behind every bench report:
# they are NOT ignored. Only the noisy install dumps are.
**/pip-install.log
**/npm-install.log
bench/clone.log

# Binarios regenerables de bench/salidas-aristas/ (c8/in, c8/out, fuga/): ~30 ficheros,
# ~406 KB. bench/salidas-aristas/MANIFIESTO.md los cubre con nombre, sha256, tamano y la
# orden exacta que los reproduce. El texto de esos mismos directorios SI entra: los
# *.pdf.txt, el .csv/.html/.md/.txt de entrada, el .tsv, los .json y —sobre todo— los
# .html/.shtml de fuga/, que son la prueba literal de que magick escribio fuera del destino.
bench/salidas-aristas/**/*.png
bench/salidas-aristas/**/*.jpg
bench/salidas-aristas/**/*.webp
bench/salidas-aristas/**/*.pdf
bench/salidas-aristas/**/*.docx
bench/salidas-aristas/**/*.odt
bench/salidas-aristas/**/*.xlsx
bench/salidas-aristas/**/*.rtf
bench/salidas-aristas/**/*.epub
bench/salidas-aristas/**/*.azw3
bench/salidas-aristas/**/*.mobi

# Los PNG de fixture de bench/salidas-quinto-punto/ se regeneran de los .svg que si estan
# versionados junto a ellos.
bench/salidas-quinto-punto/fixtures/*.png

# El lock de GPU es estado de ejecucion, no evidencia. Nunca se versiona.
bench/.gpu.lock

# Worktrees de agentes: son copias de trabajo, no contenido del repositorio.
.claude/worktrees/

# Rasteres de la tanda DESCARTADA de B21/B22 (trampa 92). Regenerables con
# bench/salidas-suelo-ppp/b21b22.py; cubiertos por su MANIFIESTO.md.
bench/salidas-suelo-ppp/img/
